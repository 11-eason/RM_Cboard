{
    "editor.formatOnSave": true,
    "[c]": {
        "editor.formatOnSave": false,
    },
    "[cpp]": {
        "editor.formatOnSave": true
    },
    "files.associations": {
        "*.hpp": "cpp",
        "*.h": "c"
    },
    "cortex-debug.variableUseNaturalFormat": true,
    "cmake.configureOnOpen": true,
    "cmake.options.advanced": {
        "configurePreset": {
            "statusBarVisibility": "visible"
        },
        "build": {
            "statusBarVisibility": "hidden"
        },
        "launch": {
            "statusBarVisibility": "hidden"
        },
        "debug": {
            "statusBarVisibility": "hidden"
        }
    }
}